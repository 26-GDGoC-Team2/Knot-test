{
  "name": "knot-backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "test": "jest",
    "db:dev": "node scripts/dev-db.mjs start",
    "db:dev:stop": "node scripts/dev-db.mjs stop",
    "db:dev:reset": "node scripts/dev-db.mjs reset",
    "migrate": "node-pg-migrate -m migrations --migration-file-language sql",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down",
    "migrate:create": "npm run migrate -- create"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "google-auth-library": "^11.3.2",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "cheerio": "^1.0.0",
    "@nestjs/schedule": "^12.0.0"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "setupFiles": [
      "reflect-metadata"
    ],
    "testEnvironment": "node"
  },
  "overrides": {
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "embedded-postgres": "17.11.0-beta.19",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.9.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.6.0",
    "@types/cheerio": "^0.22.35"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@17.11.0-beta.19": true,
    "fsevents@2.3.3": true
  }
}
