# 실제 값은 .env에만 두고 커밋하지 않는다.

# --- 인증 (JWT) ---
# secret은 32자 이상, Access/Refresh는 서로 다른 값 (생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=14d

# --- Google OAuth (서버 리다이렉트) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Cloud Console의 승인된 리디렉션 URI와 동일해야 함 (예: http://localhost:3000/auth/google/callback)
GOOGLE_REDIRECT_URI=

# --- 프론트 / 쿠키 ---
# 로그인 후 이동할 프론트 주소이자 CORS 허용 origin
FRONTEND_URL=
# 운영(production)은 기본 Secure. 프론트가 다른 사이트면 COOKIE_SAMESITE=none 과 COOKIE_SECURE=true 필요
# COOKIE_SECURE=
# COOKIE_SAMESITE=lax

# --- 최초 운영진 / 가입 코드 ---
# 이 이메일로 처음 가입하면 1회만 ADMIN 부여 (운영진이 한 명도 없을 때만)
FIRST_ADMIN_EMAIL=
# 가입 코드 암호화 키: base64 인코딩된 32바이트 (생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
JOIN_CODE_ENC_KEY=

# --- DB ---
# 앱 실행과 마이그레이션(npm run migrate:up)에 모두 사용
DATABASE_URL=
